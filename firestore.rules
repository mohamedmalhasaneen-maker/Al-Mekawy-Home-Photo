rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح لجميع زوار الموقع بقراءة وتصفح الصور والفيديوهات
    match /media/{mediaId} {
      allow read: if true;
      // السماح بالمزامنة والإضافة والحذف للمشرف المصرح له فقط
      allow write: if request.auth != null;
    }

    // السماح بقراءة الكتالوج والتعديل للمشرف فقط
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
