rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // السماح لجميع الزوار بمشاهدة وتحميل الصور والفيديوهات من أي جهاز
    match /media/{allPaths=**} {
      allow read: if true;
      // السماح بالرفع والحذف للمشرف المصرح له فقط
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
